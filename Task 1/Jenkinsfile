pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Checkstyle Enforcement') {
            steps {
                dir('Task 1') {
                    bat 'gradlew.bat :app:checkstyleMain --no-daemon'
                }
            }
        }
    }

    post {
        failure {
            echo '❌ Build blocked: Checkstyle style violations detected. Fix them and push again.'
        }
        success {
            echo '✅ Build passed: Code is compliant with UNEB e-Results standards.'
        }
    }
}