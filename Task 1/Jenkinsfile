pipeline {
    agent any

    tools {
        maven 'Maven'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Checkstyle Enforcement') {
            steps {
                dir('Task 1') {
                    bat 'mvn clean checkstyle:check'
                }
            }
        }

        stage('Build') {
            steps {
                dir('Task 1') {
                    bat 'mvn clean package'
                }
            }
        }
    }

    post {
        failure {
            echo '❌ Build blocked: Checkstyle style violations detected. Fix them and push again.'
        }
        success {
            echo '✅ Build passed: Code style is compliant with UNEB e-Results standards.'
        }
    }
}