<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash screen layout, implemented from the Figma frames (Loading + Error).
    Figma frame = 412 x 917 dp. Every number below was measured from the @2x export (px / 2).
    IDs and transitionName are used by SplashActivity, so do not rename them.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <!-- Small crest at the top -->
    <ImageView
        android:id="@+id/coatOfArms"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginTop="18.5dp"
        android:contentDescription="@null"
        android:src="@drawable/uneb_logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Large centre crest (shared element transition to the next screen) -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="144dp"
        android:layout_height="144dp"
        android:layout_marginTop="117.5dp"
        android:transitionName="logo_transition"
        android:contentDescription="UNEB LOGO"
        android:src="@drawable/uneb_logo"
        app:layout_constraintTop_toBottomOf="@id/coatOfArms"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/appName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:includeFontPadding="false"
        android:text="@string/app_name"
        android:textColor="@color/black"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28.5dp"
        android:includeFontPadding="false"
        android:text="@string/tagline"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textStyle="italic"
        app:layout_constraintTop_toBottomOf="@id/appName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Green ring spinner with a light green track (Loading state) -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:indeterminate="true"
        app:indicatorColor="@color/uneb_green"
        app:trackColor="@color/uneb_green_track"
        app:indicatorSize="56dp"
        app:indicatorInset="0dp"
        app:trackThickness="9dp"
        app:layout_constraintTop_toBottomOf="@id/tagline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- "Securing your connection..." (Loading) or the error message (Error).
         goneMarginTop is used when the spinner is hidden, so the message sits where Figma puts it. -->
    <TextView
        android:id="@+id/status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="36dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/loading_status"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:layout_goneMarginTop="52dp"
        app:layout_constraintTop_toBottomOf="@id/progress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Purple pill button (Error state). insetTop/insetBottom = 0 so it is a true 60dp tall. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/retry"
        android:layout_width="120dp"
        android:layout_height="60dp"
        android:layout_marginTop="76dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:letterSpacing="0"
        android:text="@string/retry"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:visibility="gone"
        app:backgroundTint="@color/uneb_purple"
        app:cornerRadius="30dp"
        app:layout_constraintTop_toBottomOf="@id/status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="gone" />

    <!-- Footer -->
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="40.5dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/official_app"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
